<?xml version="1.0" encoding="utf-8"?>
<!--
  CarrierPony Desktop: the desktop-owned string layer (English base).
  Only wording the Android app does not have belongs here. Anything Android already says is
  looked up in vendor/app-strings/ (synced from CarrierPonyAndroid, never edited here).
  A key declared in this file is owned by the desktop layer in every language; see Strings.kt.
  Placeholders are java.util.Formatter syntax: %1$s, %1$d.
-->
